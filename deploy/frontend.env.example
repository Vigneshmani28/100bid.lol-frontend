# Copy to deploy/frontend.env on the EC2 host.
#
# NOTE: NEXT_PUBLIC_API_URL is compiled into the JS bundle at `docker build`
# time (see the root Dockerfile's --build-arg), not read from this file at
# container start. This file exists for any future server-only runtime env
# vars; right now it can stay empty or hold NODE_ENV for clarity.

NODE_ENV=production

# Without this, Next's standalone server.js binds to os.hostname() (the
# container's own ID, e.g. 88212a70f8e0) instead of all interfaces — so
# neither the container's own healthcheck (curl localhost:3000) nor nginx's
# proxy_pass to the "frontend" service name can reliably reach it.
HOSTNAME=0.0.0.0
