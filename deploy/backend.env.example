# Copy to deploy/backend.env on the EC2 host and fill in real values.
# This file is passed to the backend container via env_file — never commit
# the filled-in version (it's already gitignored alongside backend/.env).

NODE_ENV=production
PORT=4000

APP_URL=https://100bid.lol
CORS_ORIGIN=https://100bid.lol,https://www.100bid.lol

# Replace <DB_NAME> — the database you created (or need to create, see the
# guide) inside the hundredbid-db cluster. sslmode=require is mandatory,
# Aurora rejects plaintext connections.
DATABASE_URL=postgresql://hundredbiduser:Vicky2828@hundredbid-db.c1mqqqeumr36.ap-south-1.rds.amazonaws.com:5432/<DB_NAME>?schema=public&sslmode=require

# Carried over from local dev (test mode) — switch DODO_MODE to "live" and
# swap in live keys once you're ready to accept real payments, then update
# the webhook URL in the Dodo dashboard to https://100bid.lol/api/payments/webhook
PAYMENT_PROVIDER=dodo
DODO_MODE=test
DODO_API_KEY=HOT6tHSeB74W8Gvs.KQ8DV-hsueta8RyzFSpaB3UDMTt1HOWdrg26MIWTV6crZvgT
DODO_WEBHOOK_SECRET=whsec_dsHu9udpZXC6GsUkuygXnTIaacAQuair
DODO_PRODUCT_ID=pdt_0NmZmTvuPB695Sx0SRJT2

# Recommended: EMAIL_PROVIDER=resend + EMAIL_API_KEY, sending from your own
# verified 100bid.lol domain — see the README's "Setting up email via
# Resend" section. EMAIL_PROVIDER=gmail also works but reliably lands in
# spam (no domain authentication behind a raw @gmail.com sender).
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="100BID <hello@100bid.lol>"
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Must comfortably cover Dodo's hosted checkout: sessions are valid 24h, but
# once the customer reaches the payment step Dodo gives them a 15-minute
# window — plus billing-info entry time before that. 20 = Dodo's 15 + buffer.
BID_RESERVATION_WINDOW_MINUTES=20

# DataFast website-scoped API key ("df_..."), from https://datafa.st ->
# Settings -> API keys. Powers the /admin stats page (GET
# /api/admin/datafast/stats) — leave blank to leave that page non-functional.
DATAFAST_API_KEY=
# Shared secret the /admin stats page asks for once, then remembers in the
# browser's localStorage. Set this to a long random value — it's the only
# thing gating that page. Generate one with: openssl rand -hex 32
ADMIN_STATS_TOKEN=
