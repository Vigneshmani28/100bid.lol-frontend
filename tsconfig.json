{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-build-verify/types/**/*.ts",
    ".next-build-verify/dev/types/**/*.ts",
    ".next-build-verify2/types/**/*.ts",
    ".next-build-verify2/dev/types/**/*.ts",
    ".next-build-verify3/types/**/*.ts",
    ".next-build-verify3/dev/types/**/*.ts",
    ".next-build-verify4/types/**/*.ts",
    ".next-build-verify4/dev/types/**/*.ts",
    ".next-build-verify5/types/**/*.ts",
    ".next-build-verify5/dev/types/**/*.ts",
    ".next-build-verify6/types/**/*.ts",
    ".next-build-verify6/dev/types/**/*.ts",
    ".next-build-verify7/types/**/*.ts",
    ".next-build-verify7/dev/types/**/*.ts",
    ".next-build-verify8/types/**/*.ts",
    ".next-build-verify8/dev/types/**/*.ts",
    ".next-build-verify9/types/**/*.ts",
    ".next-build-verify9/dev/types/**/*.ts",
    ".next-build-verify10/types/**/*.ts",
    ".next-build-verify10/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-verify2/types/**/*.ts",
    ".next-verify2/dev/types/**/*.ts",
    "/sessions/kind-gifted-lovelace/mnt/outputs/next-build-verify/types/**/*.ts",
    "/sessions/kind-gifted-lovelace/mnt/outputs/next-build-verify/dev/types/**/*.ts",
    "/tmp/nb-verify-dist/types/**/*.ts",
    "/tmp/nb-verify-dist/dev/types/**/*.ts",
    "build/types/**/*.ts",
    "build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "backend"
  ]
}
